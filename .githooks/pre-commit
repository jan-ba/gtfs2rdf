#!/bin/sh
set -eu

have() { command -v "$1" >/dev/null 2>&1; }

# prefers clang-format-18, fall back to clang-format
CF=clang-format-18
have "$CF" || CF=clang-format

if ! have "$CF"; then
  echo "[pre-commit] WARNING: clang-format not found; skipping auto-format."
  echo "           Install clang-format (preferably v18) to enable auto-format on commit."
  exit 0
fi

# format only staged source files under src/ and tests/, excluding src/third_party.
files=$(
  git diff --cached --name-only --diff-filter=ACMR \
    | grep -E '^(src|tests)/' \
    | grep -Ev '^src/third_party/' \
    | grep -E '\.(c|cc|cpp|cxx|h|hh|hpp|hxx|ipp|inl|ixx|cppm)$' \
    || true
)

[ -z "${files}" ] && exit 0

echo "[pre-commit] $CF on staged files"
printf "%s\n" "${files}" | xargs -r "$CF" -i --style=file

# re-stage files that were reformatted
printf "%s\n" "${files}" | xargs -r git add

exit 0
