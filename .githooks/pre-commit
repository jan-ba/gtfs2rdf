#!/bin/sh
set -eu

# Format only staged source files under src/, excluding third_party.
files=$(
  git diff --cached --name-only --diff-filter=ACMR \
    | grep -E '^src/' \
    | grep -Ev '^src/third_party/' \
    | grep -E '\.(c|cc|cpp|cxx|h|hh|hpp|hxx|ipp|inl|ixx|cppm)$' \
    || true
)

[ -z "${files}" ] && exit 0

echo "[pre-commit] clang-format on staged files"
printf "%s\n" "${files}" | xargs -r clang-format-18 -i --style=file

# Re-stage files that were reformatted
printf "%s\n" "${files}" | xargs -r git add

exit 0
